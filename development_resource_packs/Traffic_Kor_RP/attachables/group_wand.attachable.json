{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "traffic:group_wand",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/wands/group_wand",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.default_item"
      },
      "animations": {
        "setup": "animation.default_item.setup",
        "normal": "animation.default_item.normal",
        "default": "animation.default_item.default",
        "hold_first_person": "animation.default_item.hold_first_person",
        "hold_third_person": "animation.default_item.hold_third_person",
        "controller": "controller.animation.default_item"
      },
      "scripts": {
        "animate": [
          "setup",
          "normal",
          "controller",
          {
            "hold_first_person": "context.is_first_person == 1.0"
          },
          {
            "hold_third_person": "context.is_first_person == 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
