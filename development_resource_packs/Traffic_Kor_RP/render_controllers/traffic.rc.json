      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.base"
        },
        {
          "red": "Material.emissive"
        },
        {
          "green": "Material.emissive"
        },
        {
          "man": "Material.emissive"
        },
        {
          "count1": "Material.emissive"
        },
        {
          "count2": "Material.emissive"
        },
        {
          "count3": "Material.emissive"
        },
        {
          "count4": "Material.emissive"
