{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.traffic.default": {
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "geometry": "Geometry.default"
    },
    "controller.render.traffic.line": {
      "arrays": {
        "geometries": {
          "array.models": [
            "Geometry.default",
            "Geometry.slope32",
            "Geometry.slope45"
          ]
        }
      },
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "geometry": "array.models[query.property('traffic:line_shape')]"
    },
    "controller.render.traffic.road_signal": {
      "arrays": {
        "geometries": {
          "array.models": [
            "Geometry.default",
            "Geometry.variant2",
            "Geometry.variant3"
          ]
        }
      },
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.base"
        },
        {
          "red": "Material.emissive"
        },
        {
          "yellow": "Material.emissive"
        },
        {
          "green": "Material.emissive"
        }
      ],
      "geometry": "array.models[query.property('traffic:road_model_variant')]"
    },
    "controller.render.traffic.guideline": {
